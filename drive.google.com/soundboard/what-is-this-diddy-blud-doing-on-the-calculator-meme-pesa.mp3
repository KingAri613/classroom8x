<!-- Turnstile Modal Popup (client-side only) -->
<div id="cf-ts-modal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.55); z-index:99999;">
    <div style="position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); background:#1f1f1f; color:#fff; padding:20px; border-radius:8px; width: min(95vw, 380px); box-shadow: 0 10px 30px rgba(0,0,0,0.4);">
        <div style="margin-bottom:12px; font-weight:600;">Verification Required</div>
        <div style="margin-bottom:12px; font-size:14px; opacity:0.9;">Please complete the verification to continue searching.</div>
        <div id="cf-ts-widget" style="display:flex; justify-content:center; margin-bottom:12px;"></div>
        <div style="text-align:right;">
            <button id="cf-ts-cancel" type="button" style="background:#444; color:#fff; border:none; padding:8px 12px; border-radius:6px; cursor:pointer;">Cancel</button>
        </div>
    </div>
</div>

<!-- Cloudflare Turnstile API -->
<script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>
  window.TURNSTILE_SITE_KEY = window.TURNSTILE_SITE_KEY || '0x4AAAAAAB0lot5SVbCrzhnJ';
</script>
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
(function(){
  const forms = document.querySelectorAll('form.searchForm');
  const modal = document.getElementById('cf-ts-modal');
  const modalCancel = document.getElementById('cf-ts-cancel');
  const widgetContainer = document.getElementById('cf-ts-widget');
  let widgetId = null;
  let pending = null;

  function showModal(){ modal.style.display = 'block'; }
  function hideModal(){ modal.style.display = 'none'; }

  function ensureTurnstileReady(){
    return new Promise(resolve => {
      const check = () => {
        if (typeof turnstile !== 'undefined') return resolve();
        setTimeout(check, 50);
      };
      check();
    });
  }

  async function verifyViaModal(){
    await ensureTurnstileReady();
    showModal();

    if (pending) return pending; // reuse in-flight

    // Reset or render widget
    if (widgetId) {
      try { turnstile.reset(widgetId); } catch(e) {}
    } else {
      widgetId = turnstile.render(widgetContainer, {
        sitekey: window.TURNSTILE_SITE_KEY,
        size: 'normal',
        retry: 'auto',
        callback: function(){
          hideModal();
          if (pending) { pending.resolve(true); pending = null; }
        },
        'error-callback': function(){
          hideModal();
          if (pending) { pending.reject(new Error('Turnstile error')); pending = null; }
        }
      });
    }

    pending = {};
    pending.promise = new Promise((resolve, reject) => { pending.resolve = resolve; pending.reject = reject; });
    return pending.promise;
  }

  if (modalCancel) {
    modalCancel.addEventListener('click', function(){
      hideModal();
      if (pending) { pending.reject(new Error('Turnstile cancelled')); pending = null; }
    });
  }

  if (forms && forms.length) {
    forms.forEach((formEl) => {
      formEl.addEventListener('submit', async function(e){
        // If already verified in this flow, allow native submit to proceed
        if (formEl.dataset.verified === 'true') return;
        e.preventDefault();
        try {
          await verifyViaModal();
          // Mark verified and submit programmatically
          formEl.dataset.verified = 'true';
          formEl.submit();
        } catch(err) {
          console.warn('Verification aborted:', err && err.message);
        }
      });
    });
  }
})();
</script>

